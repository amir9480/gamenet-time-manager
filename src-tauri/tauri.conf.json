{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gamenet Time Manager",
  "version": "../package.json",
  "identifier": "com.gamenet.timermanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "نرم افزار مدیریت زمان گیم نت",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Amir Alizadeh",
    "homepage": "https://github.com/amir9480/gamenet-time-manager",
    "shortDescription": "Gamenet Time Manager",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
